FROM python:3.11-slim

RUN useradd -m runner
WORKDIR /workspace

RUN apt-get update && apt-get install -y build-essential libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir numpy matplotlib

COPY runner_wrapper.py /workspace/runner_wrapper.py

RUN mkdir /workspace/code /workspace/output && chown -R runner:runner /workspace
USER runner
WORKDIR /workspace
ENTRYPOINT ["python", "/workspace/runner_wrapper.py"]